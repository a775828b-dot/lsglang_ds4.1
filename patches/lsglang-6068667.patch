diff --git a/python/sglang/srt/utils/lk_moe_nvme_alloc.py b/python/sglang/srt/utils/lk_moe_nvme_alloc.py
new file mode 100644
index 0000000..c129055
--- /dev/null
+++ b/python/sglang/srt/utils/lk_moe_nvme_alloc.py
@@ -0,0 +1,29 @@
+"""Reclaimable FP4 load staging; LK owns the final CPU-resident weights.
+
+The scratch mapping stores unchanged packed bytes. It is not a quantizer or
+an inference-time expert cache. Deleted scratch files live until mappings close.
+"""
+import math
+import os
+from pathlib import Path
+import tempfile
+import numpy as np
+import torch
+
+def nvme_backed_empty(*shape, dtype):
+    root=Path(os.environ['SGLANG_LK_MOE_NVME_SCRATCH'])
+    root.mkdir(parents=True,exist_ok=True)
+    count=math.prod(shape)
+    if not count:
+        return torch.empty(*shape,dtype=dtype,device='cpu')
+    size=count*torch.empty((),dtype=dtype).element_size()
+    fd,path=tempfile.mkstemp(prefix='fp4-load-',suffix='.bin',dir=root)
+    try:
+        os.ftruncate(fd,size)
+        mapping=np.memmap(path,dtype=np.uint8,mode='r+',shape=(size,))
+    finally:
+        os.close(fd)
+        os.unlink(path)
+    tensor=torch.frombuffer(mapping,dtype=dtype).reshape(shape)
+    tensor._lk_moe_backing=mapping
+    return tensor
diff --git a/python/sglang/srt/utils/lk_source_lock.py b/python/sglang/srt/utils/lk_source_lock.py
new file mode 100644
index 0000000..2553864
--- /dev/null
+++ b/python/sglang/srt/utils/lk_source_lock.py
@@ -0,0 +1,63 @@
+"""Keep one CPU layer's source pages resident only during LK construction."""
+from contextlib import contextmanager
+import ctypes
+import json
+from pathlib import Path
+import numpy as np
+
+libc = ctypes.CDLL(None, use_errno=True)
+libnuma = ctypes.CDLL('libnuma.so.1', use_errno=True)
+
+def check(rc):
+    if rc:
+        raise OSError(ctypes.get_errno(), 'LK source page operation failed')
+
+def snapshot(stage, layer, ranges):
+    node_free = {}
+    for p in Path('/sys/devices/system/node').glob('node[0-9]*/meminfo'):
+        node_free[p.parent.name] = next(int(s.split()[3]) for s in p.read_text().splitlines() if 'MemFree:' in s)
+    maps = []
+    starts = {start for start, size in ranges}
+    # Record the VMA containing each source start, even if mappings coalesce.
+    vma_starts = set()
+    for line in Path('/proc/self/maps').read_text().splitlines():
+        lo, hi = (int(s, 16) for s in line.split()[0].split('-'))
+        if any(lo <= start < hi for start in starts):
+            vma_starts.add(lo)
+    for line in Path('/proc/self/numa_maps').read_text().splitlines():
+        if int(line.split()[0], 16) in vma_starts:
+            maps.append(line)
+    locked = next(s for s in Path('/proc/self/status').read_text().splitlines() if s.startswith('VmLck:'))
+    print('LK_SOURCE_LOCK ' + json.dumps(dict(stage=stage, layer=layer, locked=locked, node_free_kib=node_free, maps=maps)), flush=True)
+
+@contextmanager
+def lock_sources(tensors, layer):
+    mode = ctypes.c_int(); mask = (ctypes.c_ulong * 16)()
+    check(libnuma.get_mempolicy(ctypes.byref(mode), mask, 1024, None, 0))
+    if mode.value != 3 or mask[0] != 255:
+        raise RuntimeError('Expected caller NUMA interleave across nodes 0-7')
+    ranges = []
+    for tensor in tensors:
+        if tensor.device.type != 'cpu' or not tensor.is_contiguous():
+            raise ValueError('Source locking requires contiguous CPU weights')
+        ranges.append((tensor.data_ptr(), tensor.numel() * tensor.element_size()))
+    held = []
+    try:
+        for addr, size in ranges:
+            if not size:
+                continue
+            raw = np.ctypeslib.as_array((ctypes.c_ubyte * size).from_address(addr))
+            int(raw[::4096].sum())
+            check(libc.mlock(ctypes.c_void_p(addr), ctypes.c_size_t(size)))
+            held.append((addr, size))
+        snapshot('locked', layer, ranges)
+        yield
+    finally:
+        errors = []
+        for addr, size in reversed(held):
+            rc = libc.munlock(ctypes.c_void_p(addr), ctypes.c_size_t(size))
+            if rc:
+                errors.append(ctypes.get_errno())
+        snapshot('unlocked', layer, ranges)
+        if errors:
+            raise OSError(errors[0], 'Failed to unlock LK source pages')
