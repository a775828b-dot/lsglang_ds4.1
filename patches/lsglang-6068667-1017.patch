+
+    Returns:
+        Dict with "name", "arguments" (JSON string), and optional "namespace".
+    """
+    def _decode_value(key: str, value: str, string: str):
+        if string == "true":
+            value = to_json(value)
+        return f"{to_json(key)}: {value}"
