+# --- Tokenization (2026-10-21, after deepseek-recipe) ------------------------------------------------------------
+# A rendered prompt used to go through tokenizer.encode as one string, so an added-token spelling written in a user
+# message, a tool result or a tool definition (e.g. "<｜User｜>" in a file the agent reads) became a control token.
+# deepseek-recipe treats only the template's control tokens, image placeholders and the grounding tokens inside
+# assistant content / reasoning as special; everything else is plain text. Same here: content spellings are swapped
+# for private-use sentinels while rendering, the prompt is split at the remaining (template) added tokens, and the
+# plain regions -- sentinels restored -- are encoded as one batch with a copy of the tokenizer that has no added
+# vocabulary. Content without added-token spellings tokenizes exactly as before (same regions, same pipeline).
+import logging
+import os
+
+logger = logging.getLogger(__name__)
+
+GROUNDING_TOKENS = (
+    "<｜ref｜>", "<｜/ref｜>", "<｜box｜>", "<｜/box｜>",
+    "<｜point｜>", "<｜/point｜>", "<｜polygon｜>", "<｜/polygon｜>",
+)
+_SENTINEL_OPEN, _SENTINEL_CLOSE = "\ue000", "\ue001"
+_SENTINEL_RE = re.compile("\ue000([0-9]+)\ue001")
+_ASSISTANT_TEXT_KEYS = ("content", "reasoning_content", "reasoning")
+_TOKENIZER_PARTS: Dict[int, Any] = {}
+
+
+def plain_content_tokens_enabled() -> bool:
+    return os.environ.get("DS41_PLAIN_CONTENT_TOKENS", "1") != "0"
+
+
+def _tokenizer_parts(tokenizer):
+    """(plain tokenizer without added vocabulary, added spelling -> id, split pattern, grounding spellings)."""
+    parts = _TOKENIZER_PARTS.get(id(tokenizer))
+    if parts is None:
+        from tokenizers import Tokenizer
+
+        backend = getattr(tokenizer, "backend_tokenizer", None) or tokenizer._tokenizer
+        spec = json.loads(backend.to_str())
+        spec["added_tokens"] = []
+        plain = Tokenizer.from_str(json.dumps(spec))
+        plain.no_truncation()
+        plain.no_padding()
+        added = dict(tokenizer.get_added_vocab())
+        # leftmost-longest, as the tokenizer's own added-token split
+        pattern = re.compile("|".join(re.escape(t) for t in sorted(added, key=len, reverse=True)))
+        parts = (plain, added, pattern, frozenset(GROUNDING_TOKENS) & frozenset(added))
+        _TOKENIZER_PARTS[id(tokenizer)] = parts
+    return parts
+
+
+def _escape_value(value: Any, pattern, keep, store: List[str], state: Dict[str, bool]) -> Any:
+    if isinstance(value, str):
+        if _SENTINEL_OPEN in value or _SENTINEL_CLOSE in value:
+            state["collision"] = True
+
+        def repl(match):
+            spelling = match.group(0)
+            if spelling in keep:
+                return spelling
+            store.append(spelling)
+            return f"{_SENTINEL_OPEN}{len(store) - 1}{_SENTINEL_CLOSE}"
+
+        return pattern.sub(repl, value)
+    if isinstance(value, list):
+        return [_escape_value(v, pattern, keep, store, state) for v in value]
+    if isinstance(value, tuple):
+        return tuple(_escape_value(v, pattern, keep, store, state) for v in value)
+    if isinstance(value, dict):
+        return {k: _escape_value(v, pattern, keep, store, state) for k, v in value.items()}
+    return value
+
+
+def encode_messages_to_ids(
+    messages: List[Dict[str, Any]],
+    tokenizer,
+    *,
+    image_token_id: Optional[int] = None,
+    **kwargs,
+) -> Tuple[List[int], str, Dict[str, Any]]:
+    """encode_messages + tokenization. Returns (prompt ids, prompt text, media data)."""
+
+    def legacy():
+        prompt, media = encode_messages(messages, return_multi_modal_data=True, **kwargs)
+        if media["images"] and image_token_id is not None:
+            prompt = prompt.replace(IMAGE_PLACEHOLDER, tokenizer.convert_ids_to_tokens(image_token_id))
+        return tokenizer.encode(prompt), prompt, media
+
+    if not plain_content_tokens_enabled():
+        return legacy()
+    plain, added, pattern, grounding = _tokenizer_parts(tokenizer)
+    store: List[str] = []
+    state = {"collision": False}
+    safe = []
+    for msg in messages:
+        assistant = msg.get("role") == "assistant"
+        safe.append({
+            k: _escape_value(v, pattern, grounding if assistant and k in _ASSISTANT_TEXT_KEYS else (), store, state)
+            for k, v in msg.items()
+        })
+    if state["collision"]:
+        return legacy()
+    if not store:
+        safe = messages  # nothing to escape: render the caller's messages unchanged
+    prompt, media = encode_messages(safe, return_multi_modal_data=True, **kwargs)
+    if media["images"] and image_token_id is not None:
+        prompt = prompt.replace(IMAGE_PLACEHOLDER, tokenizer.convert_ids_to_tokens(image_token_id))
+    ids: List[Optional[int]] = []
+    texts: List[str] = []
+    slots: List[int] = []
+    restored = [0]
+
+    def restore(text: str) -> str:
+        def repl(match):
+            restored[0] += 1
+            return store[int(match.group(1))]
+
+        return _SENTINEL_RE.sub(repl, text) if store else text
+
+    pieces: List[str] = []
+    pos = 0
+    for match in pattern.finditer(prompt):
+        if match.start() > pos:
+            text = restore(prompt[pos:match.start()])
+            slots.append(len(ids))
+            ids.append(None)
+            texts.append(text)
+            pieces.append(text)
+        ids.append(added[match.group(0)])
+        pieces.append(match.group(0))
+        pos = match.end()
+    if pos < len(prompt):
+        text = restore(prompt[pos:])
+        slots.append(len(ids))
+        ids.append(None)
+        texts.append(text)
+        pieces.append(text)
+    if restored[0] != len(store):
+        logger.warning("dsv41 plain-content tokenization: %d of %d escaped spellings restored; "
+                       "using the single-string encoding", restored[0], len(store))
+        return legacy()
+    if texts:
+        for slot, enc in zip(slots, plain.encode_batch(texts, add_special_tokens=False)):
+            ids[slot] = enc.ids
+    flat: List[int] = []
+    for item in ids:
+        if isinstance(item, list):
+            flat.extend(item)
+        else:
+            flat.append(item)
+    return flat, "".join(pieces), media
